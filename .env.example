# 复制为 .env 后使用： cp .env.example .env
#
# 为什么密钥不能写在 application.yml 里（这是原版代码的一个真实问题）：
#   application.yml 是要提交进 git 的。密钥一旦进了 git 历史，
#   就算后来删掉，历史记录里依然存在 —— 任何能 clone 仓库的人都能翻出来。
#   补救只能是轮换密钥 + git filter-repo 重写历史，代价极高。
#
# 12-Factor App 第 3 条：配置存在环境变量里，不存在代码里。
# 生产环境用 AWS Secrets Manager / SSM Parameter Store，容器启动时注入。

# HS256 要求密钥至少 256 bit（32 字节）。生成一个：
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48_at_least_32_bytes_long_secret

POSTGRES_PASSWORD=orderstream

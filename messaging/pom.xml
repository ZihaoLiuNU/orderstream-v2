<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.orderstream</groupId>
        <artifactId>orderstream-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>messaging</artifactId>
    <name>messaging</name>

    <!--
      为什么单独开一个模块，而不是塞进 common：

      common 的纪律是「只放契约」。Outbox 和幂等消费是【基础设施实现】，不是契约。
      混在一起的话，api-gateway 和 cart-service 这些不碰数据库的服务
      也会被迫拖上 JPA 和 Kafka 依赖。

      那为什么又不在每个服务里各写一份？
        Outbox 的正确实现有很多容易写错的细节（FOR UPDATE SKIP LOCKED、
        发送失败的重试、已发送标记的时机）。复制三份等于给自己埋三个不同的 bug。
        这类【与业务无关、但实现有难度】的代码，正是最该抽成库的。

      判断标准可以概括成一句话：
        共享【业务知识】会造成耦合（危险），共享【技术机制】是正常的复用（安全）。
    -->
    <dependencies>
        <dependency>
            <groupId>com.orderstream</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Micrometer：暴露 outbox 积压量等指标。
             optional=true 是因为不是每个引用 messaging 的服务都需要监控；
             需要的服务自己引入 spring-boot-starter-actuator 即可激活 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
